<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(NETCoreSdkVersion)' &gt;= '10.0'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(NETCoreSdkVersion)' &lt; '10.0' or '$(TargetFramework)' == ''">net9.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>cpkit900</Authors>
    <Copyright>Copyright (c) 2026 cpkit900</Copyright>
    <Product>AeroRemote Desktop</Product>
    <AssemblyTitle>AeroRemote Desktop</AssemblyTitle>
    <Description>Modern FreeRDP 3 Connection Manager &amp; Desktop Workspace</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
